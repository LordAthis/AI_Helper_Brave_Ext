{
  "manifest_version": 3,
  "name": "AI Helper – MI-beszélgetések",
  "short_name": "MI-beszélgetések",
  "version": "0.1.5",
  "version_name": "0.1.5",
  "description": "Az MI-csevegések (ChatGPT, Grok, Gemini, Google AI-mód, Perplexity, Claude) mentése a saját gépen: keresés, export (Markdown, JSON, HTML, TXT, DOCX, PDF), változatok, a korábbi beszélgetések lassú, automatikus bejárása. Az adatok csak ezen a gépen.",
  "homepage_url": "https://github.com/LordAthis/AI_Helper_Brave_Ext",
  "icons": { "16": "kozos/icon16.png", "48": "kozos/icon48.png", "128": "kozos/icon128.png" },
  "action": { "default_icon": { "16": "kozos/icon16.png" }, "default_title": "MI-beszélgetések" },
  "background": { "service_worker": "aik-sw.js" },
  "permissions": ["storage", "downloads", "tabs", "favicon", "unlimitedStorage", "alarms"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://grok.com/*", "https://www.google.com/search*", "https://gemini.google.com/*", "https://claude.ai/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*"],
      "js": ["aik-common.js", "aik-adapters.js", "aik-capture.js"],
      "run_at": "document_idle"
    }
  ]
}
